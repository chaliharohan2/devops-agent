VLLM_BASE_URL=http://vllm-host:8000/v1
VLLM_API_KEY=
VLLM_MODEL=cyankiwi/Qwen3.8-27B-AWQ-INT4
DEVOPS_DEFAULT_DEPLOY_TARGET=compose
