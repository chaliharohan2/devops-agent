# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVOPS_SECRET_KEY=
# First admin token (any long random string); rotate after creating real admins.
DEVOPS_BOOTSTRAP_ADMIN_TOKEN=
